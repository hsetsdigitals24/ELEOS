# Server environment — copy to .env and adjust.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=9000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/eleos

# Allowed CORS origins, comma-separated ("*" allows all — dev only).
# Point this at the Next.js frontend, e.g. http://localhost:3000,https://eleosrein.com
CLIENT_ORIGIN=*
ADMIN_EMAIL=


# Secret used to sign admin session JWTs (min 32 chars; REQUIRED in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session lifetimes
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7

# Base URL of the frontend — used to build password-reset links.
CLIENT_URL=http://localhost:3000

# SMTP transport for outgoing mail (nodemailer). Leave SMTP_HOST empty in
# development to log emails (including reset links) to the server console.
SMTP_HOST=
SMTP_PORT=587
# "true" for SMTPS (usually port 465); anything else means STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ELEOS Research Innovations <no-reply@eleosrein.com>
