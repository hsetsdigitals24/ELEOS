# Client environment — copy to .env.local and adjust.
#
# Base URL of the Express API (server/). During development, Next.js proxies
# /api/v1/* here (see the rewrite in next.config.ts), so the browser only
# ever talks to the Next.js origin and no CORS setup is needed.
# Leave unset to disable the proxy (comment features then fall back to the
# archived comments migrated from the previous site).
VITE_API_BASE_URL=http://localhost:9000
